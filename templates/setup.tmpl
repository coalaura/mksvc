#!/bin/bash
action=setup
{{ template "lifecycle" . }}

binary="${path}/${name}"
policy_files=("$policy" "$unit_file"{{ if not .Journald }} "${conf_dir}/${name}_logs.conf"{{ end }})
private_files=("${conf_dir}/setup.sh" "${conf_dir}/uninstall.sh")

if exists "${conf_dir}/svc.yml"; then
	private_files+=("${conf_dir}/svc.yml")
fi

for file in "$binary" "${policy_files[@]}" "${private_files[@]}"; do
	check_regular_file "$file"
	check_trusted_path "$file"
done

check_directory_tree /etc/systemd/system
check_directory_tree /etc

parent=$(dirname -- "$path")
while [[ $parent != / ]]; do
	metadata=$(stat -c '%g %a' -- "$parent")
	read -r parent_gid mode <<< "$metadata"

	if [[ $parent_gid == "$gid" ]]; then
		traverse_bit=0010
	else
		traverse_bit=0001
	fi

	if (( (8#$mode & traverse_bit) == 0 )); then
		refuse "service cannot traverse ${parent}"
	fi

	parent=$(dirname -- "$parent")
done

if [[ -z $uid ]] && ! command -v systemd-sysusers >/dev/null; then
	refuse 'missing systemd-sysusers'
fi
{{- if .EnvFile }}

env_file="{{ .EnvFile }}"
check_regular_file "$env_file"
check_directory_tree "$(dirname -- "$env_file")"
check_trusted_path "$env_file"
{{- end }}
{{- if .WritableFiles }}

data_dir="${path}/data"
if exists "$data_dir" && [[ ! -d $data_dir || -L $data_dir ]]; then
	refuse "unsafe data directory: ${data_dir}"
fi
{{- end }}
{{- if .WritableConfig }}

config_file="${path}/{{ .ConfigFile }}"
if exists "$config_file"; then
	check_regular_file "$config_file"
fi
{{- end }}
{{- if not .Journald }}
{{ template "check_logging" . }}
{{- end }}

# Permission repairs do not change mtimes. Compare inputs with the running
# process, even if the manager has already reloaded the unit.
restart_needed=$needs_reload
if [[ $active == active ]]; then
	started=$(LC_ALL=C TZ=UTC systemctl show --property=ExecMainStartTimestamp --value --timestamp=us "$unit")
	main_pid=$(unit_property MainPID)

	if [[ -z $started || $main_pid == 0 ]]; then
		restart_needed=yes
	else
		changed=$(LC_ALL=C TZ=UTC find "$binary" "$unit_file"{{ if .EnvFile }} "$env_file"{{ end }} -newermt "$started" -print -quit)
		if [[ -n $changed || $(readlink -- "/proc/${main_pid}/exe") == "${binary} (deleted)" ]]; then
			restart_needed=yes
		fi
	fi
fi

set_permissions() {
	local target=$1 wanted_owner=$2 wanted_mode=$3 metadata owner mode

	metadata=$(stat -c '%u:%g %a' -- "$target")
	read -r owner mode <<< "$metadata"

	if [[ $owner != "$wanted_owner" ]]; then
		chown -- "$wanted_owner" "$target"
		mode='' # chown can clear mode bits.
	fi

	if [[ $mode != "$wanted_mode" ]]; then
		chmod -- "=${wanted_mode}" "$target"
	fi
}
{{- if or .WritableConfig (not .Journald) }}

create_empty_file() (
	set -o noclobber
	: > "$1"
)
{{- end }}

phase='setup (changes may already have been applied)'
restore_mounts=no
if [[ $runtime_wanted == yes && ! -d $runtime_dir ]]; then
	restore_mounts=yes
fi

set_permissions "$path" 0:0 755
set_permissions "$conf_dir" 0:0 755
set_permissions "$binary" 0:0 755

for file in "${private_files[@]}"; do
	set_permissions "$file" 0:0 700
done

for file in "${policy_files[@]}"; do
	set_permissions "$file" 0:0 644
done

if [[ ! -d /etc/sysusers.d ]]; then
	install -d -m 755 /etc/sysusers.d
fi

if [[ ! -L $policy_link ]]; then
	ln -sT -- "$policy" "$policy_link"
fi

if [[ -z $uid ]]; then
	systemd-sysusers "$policy_link"
	read_identity
	if [[ -z $uid || -z $gid ]]; then
		refuse 'sysusers did not create the expected identity'
	fi
fi
{{- if .WritableFiles }}

if [[ ! -d $data_dir ]]; then
	mkdir -- "$data_dir"
	restore_mounts=yes
fi

set_permissions "$data_dir" "${uid}:${gid}" 750
{{- end }}
{{- if .WritableConfig }}

if [[ ! -f $config_file ]]; then
	create_empty_file "$config_file"
	restore_mounts=yes
fi

set_permissions "$config_file" "${uid}:${gid}" 600
{{- end }}
{{- if not .Journald }}
{{ template "apply_logging" . }}
{{- else }}

if [[ -L $rotation_link ]]; then
	rm -- "$rotation_link"
fi
{{- end }}

if [[ ! -L $unit_link ]]; then
	ln -sT -- "$unit_file" "$unit_link"
	needs_reload=yes
fi

if [[ $needs_reload == yes || $load_state == not-found ]]; then
	systemctl daemon-reload
fi
{{- if or (not .HasInstallSection) .InstallCustom }}

if [[ $enabled != enabled || $needs_reload == yes ]]; then
	systemctl enable "$unit_file"
fi
{{- end }}

if [[ $active != active ]]; then
	systemctl start "$unit"
elif [[ $restart_needed == yes || $restore_mounts == yes ]]; then
	systemctl restart "$unit"
fi

echo "Setup complete: ${unit}"
