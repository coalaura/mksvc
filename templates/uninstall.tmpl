#!/bin/bash
action=uninstall
{{ template "lifecycle" . }}

for source in "$unit_file" "$policy" "${conf_dir}/${name}_logs.conf"; do
	if exists "$source"; then
		check_regular_file "$source"
		check_trusted_path "$source"
	fi
done

if [[ $origin == created ]]; then
	if [[ -n $uid ]]; then
		if ! command -v userdel >/dev/null; then
			refuse 'missing userdel'
		fi

		if [[ $(getent -s files passwd "$name") != "$(getent passwd "$name")" ]]; then
			refuse "not a local user: ${name}"
		fi
	fi

	if [[ -n $gid ]]; then
		if ! command -v groupdel >/dev/null; then
			refuse 'missing groupdel'
		fi

		if [[ $(getent -s files group "$name") != "$(getent group "$name")" ]]; then
			refuse "not a local group: ${name}"
		fi
	fi
fi

phase='uninstall (changes may already have been applied)'

if [[ $origin == legacy && ! -f $record ]]; then
	save_record pending
fi

if [[ $load_state == loaded && $active != inactive ]]; then
	systemctl stop "$unit"
fi

if [[ $enabled == enabled || $enabled == enabled-runtime ]]; then
	systemctl --no-reload disable "$unit"
fi

for link in "$unit_link" "$policy_link" "$rotation_link"; do
	if [[ -L $link ]]; then
		rm -- "$link"
	fi
done

if [[ $load_state == loaded ]]; then
	systemctl daemon-reload
fi

if [[ $origin == created ]]; then
	if [[ -n $uid ]]; then
		userdel "$name"
	fi

	# userdel can also remove the private group.
	remaining_group=$(lookup group "$name")
	if [[ -n $remaining_group ]]; then
		groupdel "$name"
	fi

	rm -- "$record"
elif [[ $origin == legacy ]]; then
	echo "Keeping the pre-existing account ${name} and its installation record."
fi

echo 'Uninstall complete. Application files were left in place.'
